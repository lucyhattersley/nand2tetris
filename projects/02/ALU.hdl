// File name: projects/02/ALU.hdl

/**
 * The ALU (Arithmetic Logic Unit).
 * Computes one of the following functions:
 * x+y, x-y, y-x, 0, 1, -1, x, y, -x, -y, !x, !y,
 * x+1, y+1, x-1, y-1, x&y, x|y on two 16-bit inputs, 
 * according to 6 input bits denoted zx,nx,zy,ny,f,no.
 * In addition, the ALU computes two 1-bit outputs:
 * if the ALU output == 0, zr is set to 1; otherwise zr is set to 0;
 * if the ALU output < 0, ng is set to 1; otherwise ng is set to 0.
 */

// Implementation: the ALU logic manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) set x = 0        // 16-bit constant
// if (nx == 1) set x = !x       // bitwise not
// if (zy == 1) set y = 0        // 16-bit constant
// if (ny == 1) set y = !y       // bitwise not
// if (f == 1)  set out = x + y  // integer 2 's complement addition
// if (f == 0)  set out = x & y  // bitwise and
// if (no == 1) set out = !out   // bitwise not
// if (out == 0) set zr = 1
// if (out < 0) set ng = 1

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute out = x + y (if 1) or x & y (if 0)
        no; // negate the out output?

    OUT 
        out[16], // 16-bit output
        zr, // 1 if (out == 0), 0 otherwise
        ng; // 1 if (out < 0),  0 otherwise

    PARTS:
    // Put your code here:
    // zx implementation
    Mux16(a=x, b=false, sel=zx, out=zxResult, out[0..7]=zxResultL, out[8..15]=zxResultR);
    
    // nx implementation
    Not16(in=zxResult, out=nxOut);
    Mux16(a=zxResult, b=nxOut, sel=nx, out=nxResult, out[15]=nxResultMSB); 

    // zy implementation
    Mux16(a=y, b=false, sel=zy, out=zyResult, out[0..7]=zyResultL, out[8..15]=zyResultR); 
   
    // ny implementation
    Not16(in=zyResult, out=nyOut); 
    Mux16(a=zyResult, b=nyOut, sel=ny, out=nyResult, out[15]=nyResultMSB); 

    // f implementation
    And16(a=nxResult, b=nyResult, out=and16Out);
    Add16(a=nxResult, b=nyResult, out=add16Out);
    Mux16(a=and16Out, b=add16Out, sel=f, out=fOut);

    // no out
    Not16(in=fOut, out=noOut);
    Mux16(a=fOut, b=noOut, sel=no, out=result);

    // final output
    Or16(a=result, b=false, out=out);

    // zr implementation 
    Or8Way(in=zxResultL, out=or8R);
    Or8Way(in=zxResultR, out=or8L); 
    Or(a=or8R, b=or8L, out=orOut);
    Not(in=orOut, out=zr);

    // ng implementation
    And(a=nxResultMSB, b=true, out=ng);    
}
