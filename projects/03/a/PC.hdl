/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    
    PARTS:
    // Order Reset > Load > Inc > Hold
    // hold or inc
    Inc16(in=in, out=i1);
    Mux16(a=in, b=i1, sel=inc, out=m1);
    
    // maybe load
    Register(in=m1, load=load, out=r1); // load

    // compute next or reset
    Mux16(a=r1, b=false, sel=reset, out=m2);
    
    // register loads when inc or load or reset
    Or16(a=m1, b=r1, out=o1);
    Or16(a=o1, b=m2, out=out);




}