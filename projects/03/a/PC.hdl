/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    
    PARTS:
    // Order Reset > Load > Inc > Hold
    Mux16(a=next, b=in, sel=load, out=m1); // in or next
 
    Register(in=m1, load=load, out=r1, out=out); // load    
    
    Mux16(a=r1, b=false, sel=reset, out=m2); // choose in/inc or reset?

    Register(in=in, load=load, out=r1) ; // load

    Mux16(a=m2, b=i1, sel=inc, out=next); // select inc 

}